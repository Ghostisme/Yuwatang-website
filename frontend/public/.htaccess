# History 路由与资源 404；相对路径同时支持根目录和 /h5/ 子目录。

Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 "Not Found"

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 实际文件、目录直接交给服务器，避免 index.html 内部重写后循环跳转。
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [END]

  # 旧路径永久重定向（需求2-3）
  RewriteRule ^(about-us|about_us)/?$ about [R=301,END,NC]
  RewriteRule ^(contact-us|contact_us)/?$ contact [R=301,END,NC]
  RewriteRule ^feature/?$ services [R=301,END,NC]
  RewriteRule ^(store|shop)/?$ stores [R=301,END,NC]
  RewriteRule ^home/?$ ./ [R=301,END,NC]
  RewriteRule ^serve/?$ services/traditional [R=301,END,NC]

  # 动态新闻/门店记录是否存在仍由后台判断，资源请求不会回落到首页。
  RewriteRule ^(about|services|base|stores|faq|news|reviews|contact|guide|trace|device-redirect|services/(moxibustion|tuina|spa|foot|traditional|cupping|gua-sha|ear-care|pedicure|pediatric-tuina)|stores/[a-z0-9-]+|news/[0-9]+)/?$ index.html [END]
  RewriteRule ^ - [R=404,END]
</IfModule>
